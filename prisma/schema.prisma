datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String            @id @default(uuid())
  username     String            @unique
  email        String            @unique
  passwordHash String
  avatar       String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  builds       Build[]
  achievements UserAchievement[]
  settings     UserSetting?
}

model Build {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  status              String   @default("IN_PROGRESS") // "IN_PROGRESS", "COMPLETED"
  progress            Float    @default(0)
  score               String?  // "S+", "A+", "A", "B", "C"
  accuracyScore       Float    @default(100)
  compatibilityScore  Float    @default(100)
  cableScore          Float    @default(100)
  errorsCount         Int      @default(0)
  buildTimeSeconds    Int      @default(0)
  isPoweredOn         Boolean  @default(false)
  currentStep         Int      @default(1)
  caseState           String   @default("OPEN")
  thermalPasteApplied Boolean  @default(false)
  cablesConnected     Boolean  @default(false)
  installedPartsJson  String   @default("{}") // JSON string of slotKey -> componentId
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model UserAchievement {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  unlockedAt DateTime @default(now())

  @@unique([userId, code])
}

model UserSetting {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  soundVolume     Float    @default(0.8)
  musicVolume     Float    @default(0.5)
  animations      Boolean  @default(true)
  graphicsQuality String   @default("HIGH")
  language        String   @default("ID")
  updatedAt       DateTime @updatedAt
}
